# Copy to .env and fill in real values. .env is gitignored; this template is committed.
# docker-compose.yml and the app both read .env (compose for ${VAR} substitution,
# the app via pydantic-settings in config/settings.py).
# 每个变量的详细说明:docs/config-reference.md

# ── Postgres (pgvector, managed by docker compose) ──────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=knowledge_base
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=change-me

# ── Neo4j (managed by docker compose) ───────────────────────────────
# NEO4J_BOLT_PORT must match the port in NEO4J_URI.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ── Embeddings (OpenAI-compatible /v1/embeddings) ───────────────────
# Model must emit 768-dim vectors (stored width is fixed).
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=

# ── HuggingFace cache (mounted into the backend container) ──────────
# Project-relative runtime dir; local reranker would cache models here.
HOME=./team-kb-runtime

# ── Chat/analysis LLM (OpenAI-compatible /chat/completions) ─────────
# Empty LLM_BASE_URL disables the LLM. LLM_MEMORY_THINKING: memory only.
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-your-api-key
LLM_MEMORY_THINKING=auto

# ── Image generation (explicit credentials, no LLM fallback) ────────
# Ark Agent Plan route; verified model: doubao-seedream-5.0-lite.
# IMAGE_MODEL=doubao-seedream-5.0-lite
PPT_ENABLED=false
PPT_MAX_PAGES=20
PI_AGENT_IMAGE_INPUT=false
IMAGE_PROVIDER=ark
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_API_KEY=

# ── Reranker (provider: local | http | none) ────────────────────────
# http mode POSTs {RERANKER_BASE_URL}/rerank; local needs --extra reranker.
RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=
RERANKER_API_KEY=

# ── Hindsight Neo4j projection worker ──────────────────────────────
# false disables the disposable Neo4j memory projection (Postgres stays authoritative).
HINDSIGHT_GRAPH_WORKER_ENABLED=true
HINDSIGHT_GRAPH_WORKER_POLL_SECONDS=1
HINDSIGHT_GRAPH_WORKER_LEASE_SECONDS=300
HINDSIGHT_GRAPH_WORKER_MAX_ATTEMPTS=10

# ── Bounded Hindsight deep search (phase deadlines) ─────────────────
HINDSIGHT_DEEP_TOTAL_TIMEOUT_SECONDS=45
HINDSIGHT_QUERY_ANALYSIS_TIMEOUT_SECONDS=8
HINDSIGHT_QUERY_EMBEDDING_TIMEOUT_SECONDS=10
HINDSIGHT_RETRIEVAL_ARM_TIMEOUT_SECONDS=5
HINDSIGHT_RERANK_TIMEOUT_SECONDS=12
HINDSIGHT_RERANK_CANDIDATE_LIMIT=40
HINDSIGHT_RERANK_TEXT_LIMIT_CHARS=4000
HINDSIGHT_RERANK_TOTAL_CHARS=60000
HINDSIGHT_KEYWORD_CANDIDATE_LIMIT=300
# Enable only after lexical backfill reports complete=true.
HINDSIGHT_KEYWORD_INDEX_ENABLED=false

# ── Recall relevance gates (public search; conversation has its own floor) ──
HINDSIGHT_RECALL_MIN_SEMANTIC=0.45
HINDSIGHT_RECALL_MIN_SCORE=0.4
# Conversation-memory recall uses its own, lower floor, so tightening the
# public gate does not decide what memories are recalled.
HINDSIGHT_CONVERSATION_RECALL_MIN_SEMANTIC=0.3

# ── Hindsight conversation memory (shared team scope) ───────────────
HINDSIGHT_CONVERSATION_MEMORY_ENABLED=true
HINDSIGHT_MIXED_SOURCE_SEARCH_ENABLED=false
# Default knowledge search keeps its full document quota and adds at most this
# many independently retrieved memories as non-citable conversation context.
HINDSIGHT_KNOWLEDGE_MEMORY_CONTEXT_ENABLED=true
HINDSIGHT_KNOWLEDGE_MEMORY_CONTEXT_LIMIT=2
HINDSIGHT_HIERARCHICAL_RETRIEVAL_ENABLED=false
HINDSIGHT_HYBRID_SAFETY_LANE_ENABLED=false
HINDSIGHT_HYBRID_SAFETY_LANE_LIMIT=3
HINDSIGHT_HYBRID_SAFETY_LANE_MIN_SCORE=0.8
HINDSIGHT_MIN_PASSAGE_SCORE=0.35
HINDSIGHT_MAX_PASSAGES_PER_DOCUMENT=3
HINDSIGHT_MAX_MEMORIES_PER_TURN=1
HINDSIGHT_LEXICAL_TITLE_WEIGHT=3.0
HINDSIGHT_LEXICAL_FILENAME_WEIGHT=2.5
HINDSIGHT_LEXICAL_OVERVIEW_WEIGHT=1.8
HINDSIGHT_LEXICAL_TAGS_WEIGHT=2.0
HINDSIGHT_LEXICAL_BODY_WEIGHT=1.0
HINDSIGHT_TRACE_CANDIDATE_LIMIT=20
HINDSIGHT_EVIDENCE_SUFFICIENCY_MIN_MARGIN=0.01
HINDSIGHT_ADAPTIVE_DEEP_SEARCH_ENABLED=false
HINDSIGHT_SELECTIVE_RETENTION_ENABLED=false
HINDSIGHT_CONVERSATION_RECALL_LIMIT=20
HINDSIGHT_CONVERSATION_MAX_TURN_CHARS=100000
HINDSIGHT_CONVERSATION_WORKER_POLL_SECONDS=1
HINDSIGHT_CONVERSATION_WORKER_LEASE_SECONDS=300
HINDSIGHT_CONVERSATION_WORKER_MAX_ATTEMPTS=10
HINDSIGHT_CONVERSATION_WORKER_MAX_CONCURRENT=1
HINDSIGHT_CONVERSATION_WORKER_RETRY_SECONDS=1
HINDSIGHT_CONVERSATION_WORKER_MAX_RETRY_SECONDS=300
HINDSIGHT_CONVERSATION_RETENTION_CONTEXT=Completed team conversation turn

# ── Auto-archiving workspace ─────────────────────────────────────────
# The workspace (inbox/ + archive/ + uploads/) lives on the workspacedata
# volume in compose. Behavior knobs default from config/app.yaml's archive:
# section; the ARCHIVE_* variables below override them without an image
# rebuild. Keep an override commented out to use the app.yaml value.
# ARCHIVE_WORKSPACE_DIR=/app/workspace
# ARCHIVE_THRESHOLD=0.75
# ARCHIVE_DELTA=0.10
# ARCHIVE_REVIEW_ALL=false
# ARCHIVE_POLL_SECONDS=5

# ── App server ──────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Uploads ─────────────────────────────────────────────────────────
# UPLOADS_DIR: compose overrides with the /app/uploads volume mount.
# KB_MAX_UPLOAD_BYTES: per-file cap (bytes), default 100 MiB.
UPLOADS_DIR=uploads
KB_MAX_UPLOAD_BYTES=104857600

# Ingest tuning lives in config/app.yaml, not env
# (chunk/doc concurrency, llm_retries, llm_backoff_base_seconds).

# ── Image build mirrors (compose build args; commented = defaults) ──
# Optional regional Debian mirrors; set both normal and security together.
# DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
# DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security

# npm registries: NPM_REGISTRY defaults to a regional mirror; NPM_AUDIT_REGISTRY
# deliberately stays on registry.npmjs.org (mirrors lack the audit API, gate
# fails closed); NPM_PROXY is a local-only build proxy, never commit a value.
# NPM_REGISTRY=https://registry.npmmirror.com
# NPM_AUDIT_REGISTRY=https://registry.npmjs.org
# NPM_PROXY=

# ── Pi Agent runtime (started by docker compose) ────────────────────
# Host-side BFF development may set PI_AGENT_URL=http://localhost:8010.
# PI_AGENT_READ_TIMEOUT_SECONDS: non-streaming /api/agent/* proxy read bound
# (unset -> 30; keep below the SPA client deadline). SSE route is unbounded.
# PI_AGENT_READ_TIMEOUT_SECONDS=30
# Pi Agent inherits LLM_*; compose supplies safe defaults for the rest.
# PI_AGENT_PORT=8010
# PI_AGENT_API=openai-completions
# PI_AGENT_EXPOSE_THINKING=false
# PI_AGENT_EXPOSE_TOOL_RESULTS=false
# Ark Seed 2.1 long PPT tool arguments need larger registered window/output.
# PI_AGENT_CONTEXT_WINDOW=65536
# PI_AGENT_MAX_OUTPUT_TOKENS=16384
# PI_AGENT_MAX_TOOL_CALLS=12
# PI_AGENT_MAX_RUN_SECONDS=1200
# PI_AGENT_TURN_RESERVE_SECONDS=60
# PI_AGENT_TRANSCRIPT_DIR=/app/data/transcripts
# Optional SHA-256 credential -> trusted scope map (keep empty until B1 accepted).
# MEMORY_SCOPE_BINDINGS={}
# TKB_DEEP_TOOL_TIMEOUT_MS=60000
# TKB_PPT_TOOL_TIMEOUT_MS=900000
# Automatic Pi recall/retention stays off until source-routing acceptance passes.
# Explicit conversation-memory MCP tools remain available from the backend.
# TKB_CONVERSATION_MEMORY_ENABLED=false
# Implicit recall/injection is independently disabled by default. Explicit MCP
# conversation-memory tools remain available when this is false.
# TKB_CONVERSATION_MEMORY_AUTO_RECALL_ENABLED=false
# TKB_CONVERSATION_MEMORY_ROUTING_TIMEOUT_MS=750
# TKB_CONVERSATION_MEMORY_ROUTING_MODEL_ENABLED=true
# TKB_CONVERSATION_MEMORY_ROUTING_CONTEXT_BUDGET_CHARS=1000
# Enable only after B2 acceptance. Startup tokens must cover each isolated binding.
# TKB_CONVERSATION_MEMORY_RELIABLE_DELIVERY=false
# PI_AGENT_MEMORY_DELIVERY_TOKENS=[]
# TKB_CONVERSATION_MEMORY_RECALL_TIMEOUT_MS=5000
# TKB_CONVERSATION_MEMORY_RECALL_LIMIT=5
# TKB_CONVERSATION_MEMORY_CONTEXT_BUDGET_CHARS=6000
# TKB_CONVERSATION_MEMORY_RETENTION_CONTEXT=Completed team conversation turn
# Agent-authored programs: build tool-job and enable tool-authoring profile.
# PI_AGENT_RUNNER_TOKEN: generate a private random token; never commit it.
PI_AGENT_TOOL_AUTHORING_ENABLED=true
PI_AGENT_RUNNER_URL=
PI_AGENT_RUNNER_TOKEN=
PI_AGENT_TOOL_LIBRARY_DIR=
PI_AGENT_MAX_CODE_JOBS=12
PI_AGENT_MAX_BUILD_ATTEMPTS=3
PI_AGENT_TIMEZONE=Asia/Shanghai
RUNNER_PUBLIC_HTTP=true
# Host socket the tool-runner gateway mounts (rootless podman: compat socket).
TOOL_RUNNER_DOCKER_SOCKET=/var/run/docker.sock
# Compose profiles to start (tool-authoring adds the tool-runner gateway).
COMPOSE_PROFILES=
