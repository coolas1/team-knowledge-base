# Copy to .env and fill in real values. .env is gitignored; this template is committed.
# docker-compose.yml and the app both read .env (compose for ${VAR} substitution,
# the app via pydantic-settings in config/settings.py).

# ── Postgres (pgvector, managed by docker compose) ──────────────────
# POSTGRES_PORT is the HOST port compose publishes (container listens on 5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=knowledge_base
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=change-me

# ── Neo4j (managed by docker compose) ───────────────────────────────
# NEO4J_BOLT_PORT must match the port in NEO4J_URI.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ── Ollama (managed by docker compose, GPU enabled) ─────────────────
# Webapp uses nomic-embed-text for 768-dimensional local embeddings.
OLLAMA_BASE_URL=http://ollama:11434

# ── HuggingFace cache (mounted into the webapp container) ───────────
# The default reranker is disabled, so no local HuggingFace model is required.
# Use a project-relative runtime directory instead of a user-specific path.
HOME=./team-kb-runtime

# ── Chat/analysis LLM (OpenAI-compatible or Ollama) ─────────────────
# Used for document analysis (overview/entities) and ask/summarize.
# This matches the current deployment: an external OpenAI-compatible API.
# Replace only the API key. To use local Ollama instead, use the commented
# values shown in docs/start.md.
LLM_PROVIDER=custom
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-your-api-key

# ── Reranker (search gatekeeper) ────────────────────────────────────
# provider: local | http | none
#   local = CrossEncoder (needs `uv sync --extra reranker` / torch, plus the
#           BAAI/bge-reranker-v2-m3 model cached in $HOME/.cache/huggingface)
#   http  = external /v1/rerank API (Cohere/Jina/OpenAI-compatible). No torch.
#           base_url is the API root; the code POSTs {base_url}/rerank.
#           e.g. Jina:  base_url=https://api.jina.ai/v1  model=jina-reranker-v2-base-multilingual
#   none  = disabled (vector top-K only, no reranking).
RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=
RERANKER_API_KEY=

# ── Hindsight Neo4j projection worker ──────────────────────────────
# PostgreSQL remains authoritative; the current deployment also maintains the
# disposable Neo4j memory projection. Set false to disable that projection.
HINDSIGHT_GRAPH_WORKER_ENABLED=true
HINDSIGHT_GRAPH_WORKER_POLL_SECONDS=1
HINDSIGHT_GRAPH_WORKER_LEASE_SECONDS=300
HINDSIGHT_GRAPH_WORKER_MAX_ATTEMPTS=10

# ── Hindsight conversation memory ─────────────────────────────────
# Shared team scope. Retention is queued and eventually consistent.
HINDSIGHT_CONVERSATION_MEMORY_ENABLED=true
HINDSIGHT_CONVERSATION_RECALL_LIMIT=20
HINDSIGHT_CONVERSATION_WORKER_POLL_SECONDS=1
HINDSIGHT_CONVERSATION_WORKER_LEASE_SECONDS=300
HINDSIGHT_CONVERSATION_WORKER_MAX_ATTEMPTS=10
HINDSIGHT_CONVERSATION_WORKER_MAX_CONCURRENT=1
HINDSIGHT_CONVERSATION_WORKER_RETRY_SECONDS=1
HINDSIGHT_CONVERSATION_WORKER_MAX_RETRY_SECONDS=300
HINDSIGHT_CONVERSATION_RETENTION_CONTEXT=Completed team conversation turn

# ── App server ──────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Pi Agent runtime (started by docker compose) ────────────────────
# A normal `docker compose up` starts Pi Agent together with the Webapp.
# Compose fixes the internal BFF URL to http://pi-agent:8010. Host-side BFF
# development may instead set PI_AGENT_URL=http://localhost:8010.
#
# Pi Agent inherits LLM_* above. Compose supplies the safe defaults, so these
# optional overrides are intentionally not active in the current .env:
# PI_AGENT_PORT=8010
# PI_AGENT_API=openai-completions
# PI_AGENT_EXPOSE_THINKING=false
# PI_AGENT_EXPOSE_TOOL_RESULTS=false
# PI_AGENT_MAX_TOOL_CALLS=12
# PI_AGENT_MAX_RUN_SECONDS=300
# TKB_CONVERSATION_MEMORY_ENABLED=true
# TKB_CONVERSATION_MEMORY_RECALL_TIMEOUT_MS=5000
# TKB_CONVERSATION_MEMORY_RECALL_LIMIT=5
# TKB_CONVERSATION_MEMORY_CONTEXT_BUDGET_CHARS=6000
# TKB_CONVERSATION_MEMORY_RETENTION_CONTEXT=Completed team conversation turn
# Optional Agent-authored programs (build tool-job and enable tool-authoring profile).
# Generate a private random token; never commit the configured value.
PI_AGENT_TOOL_AUTHORING_ENABLED=true
PI_AGENT_RUNNER_URL=
PI_AGENT_RUNNER_TOKEN=
PI_AGENT_TOOL_LIBRARY_DIR=
PI_AGENT_MAX_CODE_JOBS=12
PI_AGENT_MAX_BUILD_ATTEMPTS=3
PI_AGENT_TIMEZONE=Asia/Shanghai
RUNNER_PUBLIC_HTTP=true
