# Copy to .env and fill in real values. .env is gitignored; this template is committed.
# 只列部署自己选的事实:凭据、端点、宿主端口、路径、功能开关。行为默认值在
# config/app.yaml;任何键都可用 TKB_+大写点分路径 覆盖(详见 docs/config-reference.md)。

# ── Postgres(pgvector,由 docker compose 管理)──────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=knowledge_base
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=change-me

# ── Neo4j(由 docker compose 管理;NEO4J_BOLT_PORT 须与 NEO4J_URI 一致)─
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ── Embeddings(OpenAI 兼容 /v1/embeddings;存储宽度固定 768 维)──────
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=

# ── 对话/分析 LLM(留空 LLM_BASE_URL 即关闭 LLM)────────────────────
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=replace-with-your-api-key

# ── 重排器(provider: local | http | none;local 需 --extra reranker)──
RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=
RERANKER_API_KEY=

# ── 图像生成 / PPT(独立显式凭据,不回退 LLM;Ark Agent Plan 路由)────
PPT_ENABLED=false
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_API_KEY=
PI_AGENT_IMAGE_INPUT=false

# ── 路径、端口与上传 ────────────────────────────────────────────────
# HOME 同时是 HuggingFace 缓存目录(compose 挂载到 backend 容器)。
HOME=./team-kb-runtime
APP_HOST=0.0.0.0
APP_PORT=8000
UPLOADS_DIR=uploads
KB_MAX_UPLOAD_BYTES=104857600
# 归档工作区(inbox/ + archive/ + uploads/);行为旋钮在 config/app.yaml。
# ARCHIVE_WORKSPACE_DIR=/app/workspace

# ── Agent 自建工具(tool-runner;RUNNER_TOKEN 请自生成随机私密值)──────
PI_AGENT_TOOL_AUTHORING_ENABLED=true
PI_AGENT_RUNNER_URL=
PI_AGENT_RUNNER_TOKEN=
PI_AGENT_TOOL_LIBRARY_DIR=
TOOL_RUNNER_DOCKER_SOCKET=/var/run/docker.sock
COMPOSE_PROFILES=
