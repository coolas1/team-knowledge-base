# Postgres
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=knowledge_base
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=kb_pass

# Neo4j (复用现有容器)
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password

# Ollama
OLLAMA_BASE_URL=http://localhost:11434

# App
APP_HOST=0.0.0.0
APP_PORT=8001

# Team/auth compatibility
DEFAULT_TEAM_ID=default
ALLOW_ANONYMOUS_DEFAULT_TEAM=true
ALLOW_UNTRUSTED_TEAM_HEADER=false
# JSON: {"token-value":{"team_id":"team-a","subject":"service-a","roles":["viewer"]}}
API_TOKENS_JSON={}
# Optional legacy MCP fallback identity. Prefer an Authorization: Bearer <token>
# header on each MCP connection so Ollama users retain individual identities.
MCP_API_TOKEN=
# Comma-separated source networks allowed to use trusted Ollama usernames
# without a bearer token. Add the exact Docker subnet only when needed.
# Add only the exact browser host address (/32) when Open WebUI calls tools directly.
TRUSTED_OLLAMA_NETWORKS=127.0.0.1/32,::1/128
# Docker Open WebUI example: append its exact bridge subnet, e.g. 172.17.0.0/16

# Durable workers
OPERATION_POLL_INTERVAL=1.0
OPERATION_LEASE_SECONDS=300
PROJECTOR_POLL_INTERVAL=1.0
WORKER_MAX_ATTEMPTS=3
