# Copy to .env and fill in real values. .env is gitignored; this template is committed.
# docker-compose.yml and the app both read .env (compose for ${VAR} substitution,
# the app via pydantic-settings in config/settings.py).

# ── Postgres (pgvector, managed by docker compose) ──────────────────
# POSTGRES_PORT is the HOST port compose publishes (container listens on 5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=knowledge_base
POSTGRES_USER=kb_user
POSTGRES_PASSWORD=change-me

# ── Neo4j (managed by docker compose) ───────────────────────────────
# NEO4J_BOLT_PORT must match the port in NEO4J_URI.
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474

# ── Embeddings (OpenAI-compatible /v1/embeddings) ───────────────────
# Any OpenAI-compatible endpoint. Local Ollama: http://localhost:11434/v1
# (compose deployments with the `--profile ollama` service:
#  http://ollama:11434/v1). The model must emit 768-dim vectors — the
# stored width is fixed and the Embedder fails fast on any other width.
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_API_KEY=

# ── HuggingFace cache (mounted into the backend container) ──────────
# The default reranker is disabled, so no local HuggingFace model is required.
# Use a project-relative runtime directory instead of a user-specific path.
HOME=./team-kb-runtime

# ── Chat/analysis LLM (OpenAI-compatible /chat/completions) ─────────
# Used for document analysis (overview/entities) and ask/summarize.
# Any OpenAI-compatible API; empty LLM_BASE_URL disables the LLM.
# For local Ollama: LLM_BASE_URL=http://ollama:11434/v1  LLM_API_KEY=ollama
LLM_MODEL=deepseek-v4-flash
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_API_KEY=replace-with-your-api-key
# Background memory only; explicit policies require a supported endpoint/model.
# Ark Agent Plan example: doubao-seed-2.1-turbo at
# https://ark.cn-beijing.volces.com/api/plan/v3, LLM_MEMORY_THINKING=disabled
LLM_MEMORY_THINKING=auto

# Image presentations use an explicitly configured credential (no LLM fallback).
PPT_ENABLED=false
PPT_MAX_PAGES=20
PI_AGENT_IMAGE_INPUT=false
IMAGE_PROVIDER=ark
IMAGE_BASE_URL=
IMAGE_MODEL=
IMAGE_API_KEY=
# Agent Plan candidate: https://ark.cn-beijing.volces.com/api/plan/v3
# IMAGE_MODEL=doubao-seedream-5.0-lite

# ── Reranker (search gatekeeper) ────────────────────────────────────
# provider: local | http | none
#   local = CrossEncoder (needs `uv sync --extra reranker` / torch, plus the
#           BAAI/bge-reranker-v2-m3 model cached in $HOME/.cache/huggingface)
#   http  = external /v1/rerank API (Cohere/Jina/OpenAI-compatible). No torch.
#           base_url is the API root; the code POSTs {base_url}/rerank.
#           e.g. Jina:  base_url=https://api.jina.ai/v1  model=jina-reranker-v2-base-multilingual
#   none  = disabled (vector top-K only, no reranking).
RERANKER_PROVIDER=none
RERANKER_MODEL=BAAI/bge-reranker-v2-m3
RERANKER_BASE_URL=
RERANKER_API_KEY=

# ── Hindsight Neo4j projection worker ──────────────────────────────
# PostgreSQL remains authoritative; the current deployment also maintains the
# disposable Neo4j memory projection. Set false to disable that projection.
HINDSIGHT_GRAPH_WORKER_ENABLED=true
HINDSIGHT_GRAPH_WORKER_POLL_SECONDS=1
HINDSIGHT_GRAPH_WORKER_LEASE_SECONDS=300
HINDSIGHT_GRAPH_WORKER_MAX_ATTEMPTS=10

# ── Bounded Hindsight deep search ──────────────────────────────────
HINDSIGHT_DEEP_TOTAL_TIMEOUT_SECONDS=45
HINDSIGHT_QUERY_ANALYSIS_TIMEOUT_SECONDS=8
HINDSIGHT_QUERY_EMBEDDING_TIMEOUT_SECONDS=10
HINDSIGHT_RETRIEVAL_ARM_TIMEOUT_SECONDS=5
HINDSIGHT_RERANK_TIMEOUT_SECONDS=12
HINDSIGHT_RERANK_CANDIDATE_LIMIT=40
HINDSIGHT_RERANK_TEXT_LIMIT_CHARS=4000
HINDSIGHT_RERANK_TOTAL_CHARS=60000
HINDSIGHT_KEYWORD_CANDIDATE_LIMIT=300
# Enable only after lexical backfill reports complete=true.
HINDSIGHT_KEYWORD_INDEX_ENABLED=false

# ── Recall relevance gates ─────────────────────────────────────────
# Public search/answer recall: the semantic floor applies in every mode,
# and the deep-mode rerank-score gate applies on top of it.
HINDSIGHT_RECALL_MIN_SEMANTIC=0.45
HINDSIGHT_RECALL_MIN_SCORE=0.4
# Conversation-memory recall uses its own, lower floor, so tightening the
# public gate does not decide what memories are recalled.
HINDSIGHT_CONVERSATION_RECALL_MIN_SEMANTIC=0.25

# ── Hindsight conversation memory ─────────────────────────────────
# Shared team scope. Retention is queued and eventually consistent.
HINDSIGHT_CONVERSATION_MEMORY_ENABLED=true
HINDSIGHT_CONVERSATION_RECALL_LIMIT=20
# Retained turn content cap (chars): longer turns are truncated with a
# [truncated] marker so one pasted document cannot fan out into dozens of
# LLM extraction calls.
HINDSIGHT_CONVERSATION_MAX_TURN_CHARS=100000
HINDSIGHT_CONVERSATION_WORKER_POLL_SECONDS=1
HINDSIGHT_CONVERSATION_WORKER_LEASE_SECONDS=300
HINDSIGHT_CONVERSATION_WORKER_MAX_ATTEMPTS=10
HINDSIGHT_CONVERSATION_WORKER_MAX_CONCURRENT=1
HINDSIGHT_CONVERSATION_WORKER_RETRY_SECONDS=1
HINDSIGHT_CONVERSATION_WORKER_MAX_RETRY_SECONDS=300
HINDSIGHT_CONVERSATION_RETENTION_CONTEXT=Completed team conversation turn

# ── App server ──────────────────────────────────────────────────────
APP_HOST=0.0.0.0
APP_PORT=8000

# ── Uploads ─────────────────────────────────────────────────────────
# Where original uploaded files live. The compose deployment overrides this
# with the absolute volume mount (/app/uploads) so uploads survive container
# recreation; the relative default is for host-side development.
UPLOADS_DIR=uploads
# Per-file upload size cap (bytes) for both single and batch uploads.
# Over-cap files are rejected with 413 file_too_large without buffering the
# body beyond the cap. Default 100 MiB.
KB_MAX_UPLOAD_BYTES=104857600

# Ingest tuning lives in config/app.yaml, not env:
#   engine.ingest.chunk_concurrency / doc_concurrency  (parallelism)
#   engine.ingest.llm_retries                          (transient-failure retries)
#   engine.ingest.llm_backoff_base_seconds             (backoff base, capped 30s)

# ── Image build mirrors (compose build args; commented = defaults) ──
# Fixed system packages, including LibreOffice and Noto CJK, are installed in
# a source-independent cached layer. Optional regional Debian mirrors can be
# used when the upstream route is unstable; configure both normal and security
# repositories together. Empty values retain the official Debian endpoints.
# DEBIAN_MIRROR=https://mirrors.aliyun.com/debian
# DEBIAN_SECURITY_MIRROR=https://mirrors.aliyun.com/debian-security

# npm registries:
# NPM_REGISTRY: where `npm ci` in the image build fetches packages. Defaults
#   to a regional mirror (registry.npmmirror.com) because direct
#   registry.npmjs.org fetches stall on some LAN hosts. npm ci verifies
#   every tarball against the package-lock integrity hashes, so a mirror
#   can withhold a package but cannot substitute content. Point at
#   https://registry.npmjs.org (or another mirror) to override.
# NPM_AUDIT_REGISTRY: the registry `npm run security` audits against.
#   Deliberately defaults to the authoritative registry.npmjs.org: registry
#   mirrors do not implement npm's audit API, and the security gate fails
#   closed - pointing this at a mirror blocks the build, by design.
# NPM_PROXY: proxy for build-time npm fetches (npm ignores HTTP(S)_PROXY;
#   it reads only npm_config_proxy). A local-only opt-in, empty by default;
#   never commit a machine-specific value.
# NPM_REGISTRY=https://registry.npmmirror.com
# NPM_AUDIT_REGISTRY=https://registry.npmjs.org
# NPM_PROXY=

# ── Pi Agent runtime (started by docker compose) ────────────────────
# A normal `docker compose up` starts Pi Agent together with the backend.
# Compose fixes the internal BFF URL to http://pi-agent:8010. Host-side BFF
# development may instead set PI_AGENT_URL=http://localhost:8010.
#
# Read bound (seconds) for the non-streaming /api/agent/* proxy routes —
# session list/detail/create/delete/cancel and memory-forget. A sidecar that
# accepts the connection but never answers becomes a 504 instead of an
# indefinitely pending request. The SSE message route is deliberately NOT
# bounded by this (a long model turn must not be cut mid-answer); it keeps
# read=None with bounded connect/write/pool. Unset -> 30. Set 0 or negative
# to disable the bound. Keep the SPA's client deadline
# (VITE_AGENT_REQUEST_TIMEOUT_MS) above this value, or the client aborts
# first and the server's more specific error is never seen.
# PI_AGENT_READ_TIMEOUT_SECONDS=30
#
# Pi Agent inherits LLM_* above. Compose supplies the safe defaults, so these
# optional overrides are intentionally not active in the current .env:
# PI_AGENT_PORT=8010
# PI_AGENT_API=openai-completions
# PI_AGENT_EXPOSE_THINKING=false
# PI_AGENT_EXPOSE_TOOL_RESULTS=false
# PI_AGENT_MAX_TOOL_CALLS=12
# PI_AGENT_MAX_RUN_SECONDS=1200
# PI_AGENT_TURN_RESERVE_SECONDS=60
# PI_AGENT_TRANSCRIPT_DIR=/app/data/transcripts
# Optional SHA-256 credential -> trusted scope map, shared by BFF and Pi.
# Keep empty/unset until B1 is accepted; see docs/memory-scope.md.
# MEMORY_SCOPE_BINDINGS={}
# TKB_DEEP_TOOL_TIMEOUT_MS=60000
# TKB_PPT_TOOL_TIMEOUT_MS=900000
# TKB_CONVERSATION_MEMORY_ENABLED=true
# Enable only after B2 acceptance. Startup tokens must cover each isolated binding.
# TKB_CONVERSATION_MEMORY_RELIABLE_DELIVERY=false
# PI_AGENT_MEMORY_DELIVERY_TOKENS=[]
# TKB_CONVERSATION_MEMORY_RECALL_TIMEOUT_MS=5000
# TKB_CONVERSATION_MEMORY_RECALL_LIMIT=5
# TKB_CONVERSATION_MEMORY_CONTEXT_BUDGET_CHARS=6000
# TKB_CONVERSATION_MEMORY_RETENTION_CONTEXT=Completed team conversation turn
# Optional Agent-authored programs (build tool-job and enable tool-authoring profile).
# Generate a private random token; never commit the configured value.
PI_AGENT_TOOL_AUTHORING_ENABLED=true
PI_AGENT_RUNNER_URL=
PI_AGENT_RUNNER_TOKEN=
PI_AGENT_TOOL_LIBRARY_DIR=
PI_AGENT_MAX_CODE_JOBS=12
PI_AGENT_MAX_BUILD_ATTEMPTS=3
PI_AGENT_TIMEZONE=Asia/Shanghai
RUNNER_PUBLIC_HTTP=true
