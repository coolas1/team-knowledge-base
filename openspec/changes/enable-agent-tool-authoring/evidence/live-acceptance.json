    {
      "id": "json_group",
      "passed": true,
      "artifact": {
        "name": "gen_accept_group",
        "description": "Accumulate amounts by team. Input {rows:[{team:string,amount:number}]}; returns an object keyed by team with summed amounts. Empty rows array returns {}.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "rows": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "team": {
                    "type": "string"
                  },
                  "amount": {
                    "type": "number"
                  }
                },
                "required": [
                  "team",
                  "amount"
                ]
              }
            }
          },
          "required": [
            "rows"
          ]
        },
        "outputSchema": {
          "type": "object"
        },
        "capabilities": [],
        "tests": [
          {
            "input": {
              "rows": [
                {
                  "team": "red",
                  "amount": 3
                },
                {
                  "team": "blue",
                  "amount": 7
                },
                {
                  "team": "red",
                  "amount": -1
                }
              ]
            },
            "expected": {
              "red": 2,
              "blue": 7
            }
          },
          {
            "input": {
              "rows": []
            },
            "expected": {}
          },
          {
            "input": {
              "rows": [
                {
                  "team": "a",
                  "amount": -5
                }
              ]
            },
            "expected": {
              "a": -5
            }
          }
        ],
        "code": "export default async function(input, host) {\n  const rows = input.rows || [];\n  const result = {};\n  for (const row of rows) {\n    const key = String(row.team);\n    result[key] = (result[key] || 0) + row.amount;\n  }\n  return result;\n}",
        "version": 1,
        "hash": "e4e769dd97ecc9061f7e037e18abefea59e26948536ae3611d5b70f0be7b62ec",
        "versionHash": "062e4c5644b2b3af53ca83ade34694c45cee4544bde8316dff0f7f7999128962",
        "runtime": "sha256:550a229d42dcdbc3500a40b06a87fc1c7e6b4ac7028504ff29000b1ebe88d17d",
        "active": true
      },
      "independent": {
        "input": {
          "rows": [
            {
              "team": "unseen",
              "amount": 2.25
            },
            {
              "team": "other",
              "amount": 4
            },
            {
              "team": "unseen",
              "amount": -0.5
            }
          ]
        },
        "expected": {
          "unseen": 1.75,
          "other": 4
        },
        "actual": {
          "jobId": "786dffda-878f-4d55-9d8a-7939f6dfe87e",
          "status": "succeeded",
          "result": {
            "unseen": 1.75,
            "other": 4
          },
          "logs": "",
          "runtime": "sha256:550a229d42dcdbc3500a40b06a87fc1c7e6b4ac7028504ff29000b1ebe88d17d"
        }
