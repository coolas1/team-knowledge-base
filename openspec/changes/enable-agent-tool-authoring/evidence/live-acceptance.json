      "id": "timezone",
      "passed": true,
      "artifact": {
        "name": "gen_accept_date",
        "description": "Convert an ISO instant or \"now\" to a YYYY-MM-DD date string in a given IANA time zone.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "instant": {
              "type": "string"
            },
            "zone": {
              "type": "string"
            }
          },
          "required": [
            "instant",
            "zone"
          ],
          "additionalProperties": false
        },
        "outputSchema": {
          "type": "string"
        },
        "capabilities": [],
        "tests": [
          {
            "input": {
              "instant": "2026-09-04T16:30:00Z",
              "zone": "Asia/Shanghai"
            },
            "expected": "2026-09-05"
          },
          {
            "input": {
              "instant": "2026-09-04T16:30:00Z",
              "zone": "UTC"
            },
            "expected": "2026-09-04"
          }
        ],
        "code": "export default async (input, host) => {\n  const instant = input.instant === \"now\" ? new Date() : new Date(input.instant);\n  if (Number.isNaN(instant.getTime())) throw new Error(\"invalid instant\");\n  const fmt = new Intl.DateTimeFormat(\"en-CA\", {\n    timeZone: input.zone,\n    year: \"numeric\",\n    month: \"2-digit\",\n    day: \"2-digit\",\n  });\n  const parts = fmt.formatToParts(instant);\n  const get = (t) => parts.find((p) => p.type === t).value;\n  return `${get(\"year\")}-${get(\"month\")}-${get(\"day\")}`;\n};",
        "version": 1,
        "hash": "5ea99657988c6385ce0e4b29db1b63311b020a3427607d37355ac37c4bc41af1",
