    {
      "id": "repair",
      "passed": true,
      "artifact": {
        "name": "gen_accept_uppercase",
        "description": "Uppercase every string in a provided array. Given {values: string[]}, returns an array with each string converted to uppercase.",
        "inputSchema": {
          "type": "object",
          "required": [
            "values"
          ],
          "properties": {
            "values": {
              "type": "array",
              "items": {
                "type": "string"
              }
            }
          }
        },
        "outputSchema": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "capabilities": [],
        "tests": [
          {
            "input": {
              "values": [
                "hello",
                "world"
              ]
            },
            "expected": [
              "HELLO",
              "WORLD"
            ]
          },
          {
            "input": {
              "values": [
                "a",
                "Bc",
                "xyz"
              ]
            },
            "expected": [
              "A",
              "BC",
              "XYZ"
            ]
          },
          {
            "input": {
              "values": []
            },
            "expected": []
          },
          {
            "input": {
              "values": [
                "mixed",
                "Case"
              ]
            },
            "expected": [
              "MIXED",
              "CASE"
            ]
          }
        ],
        "code": "export default async (input) => {\n  const { values } = input;\n  if (!Array.isArray(values)) {\n    throw new Error(\"input.values must be an array\");\n  }\n  if (values.some((v) => typeof v !== \"string\")) {\n    throw new Error(\"input.values must only contain strings\");\n  }\n  return values.map((v) => v.toUpperCase());\n}",
