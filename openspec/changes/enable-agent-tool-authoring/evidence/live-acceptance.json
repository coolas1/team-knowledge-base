      "id": "web",
      "passed": true,
      "artifact": {
        "name": "gen_accept_title",
        "description": "Fetch a public web page and return its <title> text as a plain string, using host.fetch and htmlparser2.",
        "inputSchema": {
          "type": "object",
          "properties": {
            "url": {
              "type": "string"
            }
          },
          "required": [
            "url"
          ]
        },
        "outputSchema": {
          "type": "string"
        },
        "capabilities": [
          "public_http"
        ],
        "tests": [
          {
            "input": {
              "url": "https://example.com/"
            },
            "expected": "Example Domain"
          },
          {
            "input": {
              "url": ""
            },
            "expectError": "execution_failed"
          },
          {
            "input": {
              "url": "https://example.com/nonexistent-path-xyz"
            },
            "expectError": "execution_failed"
          }
        ],
        "code": "import { Parser } from \"htmlparser2\";\n\nexport default async function (input, host) {\n  const url = input.url;\n  if (typeof url !== \"string\" || url.length === 0) {\n    throw new Error(\"input.url must be a non-empty string\");\n  }\n  let res;\n  try {\n    res = await host.fetch({ url, method: \"GET\" });\n  } catch (e) {\n    throw new Error(\"network error fetching \" + url + \": \" + e.message);\n  }\n  if (res.status !== 200) {\n    throw new Error(\"fetch failed: HTTP \" + res.status + \" for \" + url);\n  }\n  const html = res.text ?? \"\";\n  let title = null;\n  let inTitle = false;\n  let found = false;\n  const parser = new Parser({\n    onopentag(name) {\n      if (found) return;\n      if (name === \"title\") inTitle = true;\n    },\n    ontext(text) {\n      if (inTitle && !found) title = (title ?? \"\") + text;\n    },\n    onclosetag(name) {\n      if (name === \"title\") { inTitle = false; found = true; }\n    },\n  });\n  parser.write(html);\n  parser.end();\n  return (title ?? \"\").trim();\n}\n",
        "version": 1,
        "hash": "c7b47a9ad91e859cd529600b3a37c94ebce3e652a5661e026762071dac99608e",
        "versionHash": "f496e5b3c38b3fa1cd475c64b189a0893a5eafcdc9dfc5d50c23fe5aa15843a7",
