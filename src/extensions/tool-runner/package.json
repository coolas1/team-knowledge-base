{
  "name": "@team-knowledge-base/tool-runner",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=24.0.0" },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "node scripts/integration.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "security": "npm audit --omit=dev --audit-level=high",
    "start": "node dist/server.js"
  },
  "dependencies": { "ipaddr.js": "2.2.0", "htmlparser2": "10.0.0" },
  "devDependencies": { "@types/node": "26.1.1", "typescript": "7.0.2", "vitest": "4.1.9" }
}
