{
  "name": "@team-knowledge-base/pi-agent-adapter",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Pi Agent adapter for the Team Knowledge Base MCP engine",
  "files": [
    "dist",
    "scripts",
    "skills",
    "README.md"
  ],
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js",
    "./runtime": "./dist/runtime.js",
    "./server": "./dist/server.js"
  },
  "pi": {
    "extensions": [
      "./dist/index.js"
    ],
    "skills": [
      "./skills"
    ]
  },
  "scripts": {
    "postinstall": "node scripts/enforce-secure-deps.mjs",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/server.js",
    "smoke": "node dist/smoke.js",
    "security:local": "node scripts/security-gate.mjs --local",
    "security:audit": "npm audit --omit=dev --audit-level=high",
    "security": "npm run security:local && npm run security:audit",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run security:local && npm run typecheck && npm test && npm run build"
  },
  "dependencies": {
    "@earendil-works/pi-coding-agent": "0.83.0",
    "@modelcontextprotocol/sdk": "1.30.0",
    "brace-expansion": "5.0.9",
    "typebox": "1.3.7",
    "undici": "8.9.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  }
}
